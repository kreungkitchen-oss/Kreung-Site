---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PressGrid from '../components/PressGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import { story, khmer, kreungIngredients, business } from '../data/business';
import { personSam } from '../data/schema';
import { tone } from '../data/tones';
import samChristina from '../assets/photos/sam-christina-wedding.jpg';
import grilling from '../assets/photos/team-grilling.jpg';
import babySam from '../assets/photos/sam-baby-khao-i-dang.jpg';
import mak from '../assets/photos/mak.jpg';

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Our Story', path: '/about' }];
---
<BaseLayout
  title="Our Story: Sam, Christina and Mak | Kreung LA"
  description="How a promise to his mother, Mak, became Kreung LA. Sam Oum's journey from a refugee camp to Cambodian street BBQ in Culver City."
  path="/about"
  jsonLd={[personSam()]}
>
  <section class="sec page-hero" {...tone('yellow')}>
    <div class="wrap split split--wide">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1>Our Story: Sam, Christina and Mak</h1>
        <p class="lede">Kreung LA started with a promise. "I'm gonna bring Cambodian food to LA." Sam said it to his mother for years. Now we cook for her every day.</p>
        <div class="btn-row"><a class="btn" href="/catering">Book us for your event</a></div>
      </div>
      <figure class="photo">
        <Image src={samChristina} alt="Sam and Christina of Kreung LA in their black Kreung shirts" widths={[480, 800]} sizes="(min-width: 960px) 460px, 100vw" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="sec" {...tone('plum')} aria-labelledby="story-h">
    <div class="wrap story-grid" id="sam-oum">
      <div class="prose story-prose">
        <h2 id="story-h">Sam's story</h2>
        <p>Sam Oum was born in Khao-I-Dang, a refugee camp on the Thai-Cambodian border. His family resettled in North Carolina, far from any Cambodian community.</p>
        <p>In 2011 he moved to Long Beach, the heart of Cambodian LA. In 2017 he moved to Culver City. That's where he met Christina, and where he started cooking his mother's dishes himself.</p>
      </div>
      <figure class="snap snap--l">
        <Image src={babySam} alt="Black-and-white photo of Sam as a baby, held up behind a small chalkboard that reads OUM SAMOEUN" widths={[360, 640]} sizes="(min-width: 860px) 340px, 80vw" />
        <figcaption>Sam as a baby in the Khao-I-Dang refugee camp.</figcaption>
      </figure>
      <figure class="snap snap--r">
        <Image src={mak} alt="Sam's mother, Mak, smiling in a green lace top in front of a floral curtain" widths={[360, 640]} sizes="(min-width: 860px) 360px, 80vw" />
        <figcaption>Mak (<span lang="km">{khmer.mak}</span>), Sam's mother.</figcaption>
      </figure>
      <div class="prose story-prose">
        <h2>A promise to Mak</h2>
        <p>For years, Sam told his mother, Mak (<span lang="km">{khmer.mak}</span>), "I'm gonna bring Cambodian food to LA."</p>
        <p>Mak passed in late November 2023. Her last words to him were to stop talking and start doing.</p>
        <p>On January 1, 2024, her birthday, Kreung LA got its first catering order. That's why our footer says <strong>{business.taglines.footer}</strong></p>
      </div>
    </div>
  </section>

  <section class="sec" {...tone('cream')} aria-labelledby="time-h">
    <div class="wrap">
      <h2 id="time-h">The road to Kreung LA</h2>
      <ol class="timeline">
        {story.timeline.map((t) => (
          <li>
            {t.place === 'Khao-I-Dang' && <Image class="tl-photo" src={babySam} alt="" widths={[160, 320]} sizes="160px" />}
            <span class="yr">{t.year === 'Childhood' ? 'Growing up' : t.year}</span><b>{t.place}</b><span>{t.text}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec" {...tone('orange')} aria-labelledby="why-h">
    <div class="wrap split">
      <div>
        <h2 id="why-h">Why kreung?</h2>
        <p class="lede">Kreung (<span lang="km">{khmer.kreung}</span>) is the herb paste at the heart of Cambodian cooking. It's what makes our BBQ taste like home.</p>
        <ul class="herb-list">
          {kreungIngredients.map((i) => <li>{i.en} <span lang="km">{i.km}</span></li>)}
        </ul>
        <p>We marinate every meat in it, then grill it over fire. That's why we named ourselves after it. <a class="inline-link" href="/guides/what-is-kreung">Learn more about kreung</a></p>
      </div>
      <figure class="photo">
        <Image src={grilling} alt="The Kreung LA team grilling skewers over open fire" widths={[480, 800]} sizes="(min-width: 960px) 460px, 100vw" />
      </figure>
    </div>
  </section>

  <section class="sec" {...tone('teal')} aria-labelledby="press-h">
    <div class="wrap">
      <h2 id="press-h">In the press</h2>
      <PressGrid />
      <p><a class="inline-link" href="/press">Press and media</a></p>
    </div>
  </section>

  <CtaBand heading="Taste the story." text="Book Cambodian BBQ catering for your next event, or find us at a market this week." href="/catering" label="Book us for your event" />
</BaseLayout>

<style>
  .story-prose { font-size: 19px; }
  .story-prose h2:first-child { margin-top: 0; }
  .story-grid { display: grid; gap: 32px; align-items: center; }
  @media (min-width: 860px) {
    .story-grid { grid-template-columns: 1.4fr 1fr; column-gap: 56px; row-gap: 48px; }
    .snap--r { grid-row: 2; grid-column: 1; justify-self: center; }
    .story-grid > .prose:last-child { grid-row: 2; grid-column: 2; }
  }
  .snap { margin: 0; justify-self: center; max-width: 360px; background: var(--cream); color: var(--plum); padding: 12px 12px 14px; border-radius: 6px; box-shadow: 8px 8px 0 rgba(0, 0, 0, 0.35); }
  .snap--l { transform: rotate(2deg); }
  .snap--r { transform: rotate(-2deg); }
  .snap :global(img) { width: 100%; height: auto; border-radius: 3px; }
  .snap figcaption { margin-top: 10px; font-size: 15px; font-weight: 600; text-align: center; }
  :global(.tl-photo) { width: 100%; max-width: 160px; height: auto; border-radius: 10px; margin-bottom: 8px; filter: grayscale(1); }
  .timeline { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 14px; }
  .timeline li { display: grid; gap: 4px; align-content: start; background: var(--white); border: 2.5px solid var(--plum); border-radius: 18px; padding: 16px 20px; box-shadow: 5px 5px 0 var(--plum); }
  .timeline .yr { font-stretch: 75%; font-weight: 900; text-transform: uppercase; font-size: 26px; line-height: 1; color: var(--pink-d); }
  .timeline b { font-size: 19px; }
  .herb-list { list-style: none; padding: 0; margin: 18px 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-weight: 700; }
  .herb-list li { background: var(--cream); color: var(--plum); border: 2px solid var(--plum); border-radius: 12px; padding: 8px 12px; }
  .herb-list span { display: block; font-weight: 400; font-size: 14px; }
  .inline-link { font-weight: 800; }
  @media (min-width: 900px) { .timeline { grid-template-columns: repeat(5, 1fr); } }
</style>
