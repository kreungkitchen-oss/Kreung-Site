---
/**
 * Review quotes. Only approved, real quotes from business.ts.
 * `placeholders` adds empty "[REAL QUOTE NEEDED]" slots for quotes Sam still
 * needs to collect. They show on deploy previews only, never on the live site.
 */
import { reviews, type Review } from '../data/business';
import Placeholder from './Placeholder.astro';
interface Props { keys?: (keyof typeof reviews)[]; placeholders?: string[] }
const { keys = Object.keys(reviews) as (keyof typeof reviews)[], placeholders = [] } = Astro.props;
const list: Review[] = keys.map((k) => reviews[k]);
---
<div class="grid grid--3 reviews">
  {list.map((r) => (
    <figure class={`quote${r.short ? ' quote--big' : ''}`}>
      <span class="stars" aria-hidden="true">★★★★★</span>
      <blockquote><p>{r.quote}</p></blockquote>
      <figcaption>{r.author}<span>, {r.source}</span></figcaption>
    </figure>
  ))}
  {placeholders.map((d) => <Placeholder as="figure" label="REAL QUOTE NEEDED" detail={d} />)}
</div>
