---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Packages from '../components/Packages.astro';
import ProofBar from '../components/ProofBar.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { policies, money, press } from '../data/business';
import spread from '../assets/photos/event-indoor-buffet.jpg';
import grilling from '../assets/photos/team-grilling.jpg';

const kinds = [
  { href: '/catering/corporate', title: 'Corporate catering', text: 'Team lunches, all-hands and office parties. Dropped off hot and set up.' },
  { href: '/catering/on-site-grill', title: 'On-site grill', text: 'We bring the grill and cook for your guests, live.' },
  { href: '/catering/film-production', title: 'Production & studio', text: 'Crew meals for film, TV, music and photo shoots.' },
  { href: '/catering/office-lunch-club', title: 'Office Lunch Club', text: 'A standing Cambodian BBQ lunch for your team.' },
  { href: '/catering/cambodian', title: 'Cambodian catering', text: 'Real Khmer flavors for any party in LA.' },
  { href: '/catering/southeast-asian', title: 'Southeast Asian catering', text: 'Bright, herby food that is not the usual Thai tray.' },
  { href: '/catering/aapi-heritage-month', title: 'AAPI Heritage Month', text: 'A Cambodian American story your team can taste.' },
  { href: '/catering/holiday-party', title: 'Holiday parties', text: 'Year-end parties with smoke, fire and big flavor.' },
];

const faqs = [
  { q: 'How much does catering cost?', a: `Packages are $20, $25 or $33 per person, and delivery starts at $${policies.deliveryFrom}. Sales tax applies, and some orders have a production fee. Our pricing page has the full details.` },
  { q: 'What is the minimum order?', a: `${money(policies.minimumDropoff)} for pickup and drop-off. ${money(policies.minimumOnsite)} when we bring our grill on-site.` },
  { q: 'How many guests can you feed?', a: `We cater for ${policies.guestsLabel} guests. That covers small team lunches up to company-wide events and weddings.` },
  { q: 'How far ahead should I book?', a: `Please book at least ${policies.leadTimeDays} days (2 weeks) ahead. ${policies.responseTime}` },
  { q: 'Do you deliver?', a: `Yes, to ${policies.deliveryArea}. Delivery starts at $${policies.deliveryFrom} and includes setup.` },
  { q: 'Do you have vegan options?', a: 'Yes. Our tofu skewers are vegan. Our food contains no dairy or peanuts.' },
];

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Catering', path: '/catering' }];
---
<BaseLayout
  title="Catering in Los Angeles for Every Event | Kreung LA"
  description="Cambodian BBQ catering for 30 to 300+ guests in LA. Packages from $20 per person. Drop-off, pickup or our grill on-site. Quotes in 24 hours."
  path="/catering"
>
  <section class="sec s-yellow page-hero">
    <div class="wrap split split--wide">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1>Catering in Los Angeles: Cambodian BBQ for Every Event</h1>
        <p class="lede">Fire-grilled meats marinated in kreung, with rice, coconut corn, pickled vegetables and house sauces. We feed {policies.guestsLabel} guests, from office lunches to weddings.</p>
        <div class="btn-row">
          <a class="btn" href="/catering/corporate#estimate">Get a catering quote</a>
          <a class="btn btn--o" href="/catering/menu">See the menu</a>
        </div>
      </div>
      <figure class="photo">
        <Image src={spread} alt="A Kreung LA catering buffet set up indoors with trays of grilled meats, rice and sides" widths={[480, 800]} sizes="(min-width: 960px) 460px, 100vw" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="sec s-plum" aria-labelledby="pk-h">
    <div class="wrap">
      <div class="head">
        <h2 id="pk-h">Pick a package</h2>
        <p class="lede">Three simple packages, priced per person.</p>
      </div>
      <Packages />
      <p class="dl">Delivery covers {policies.deliveryArea}, from ${policies.deliveryFrom}, setup included. <a href="/catering/pricing">How pricing works</a> · <a href="/catering/menu">Full catering menu</a></p>
    </div>
  </section>

  <section class="sec s-cream" aria-labelledby="kinds-h">
    <div class="wrap">
      <div class="head">
        <h2 id="kinds-h">What kind of event?</h2>
        <p class="lede">Pick the one that sounds like yours.</p>
      </div>
      <ul class="grid grid--4 doors" role="list">
        {kinds.map((k) => (
          <li><a class="card card--link" href={k.href}><h3>{k.title}</h3><p>{k.text}</p><span class="more" aria-hidden="true">Go →</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec s-teal" aria-labelledby="how-h">
    <div class="wrap split">
      <div>
        <h2 id="how-h">How it works</h2>
        <ol class="howto">
          <li><b>Tell us about your event.</b> Our estimator shows a ballpark price in a minute.</li>
          <li><b>Get your quote.</b> We reply within 24 hours, aiming for same day. Estimates in 24–48 hours.</li>
          <li><b>Lock in your date.</b> Book at least {policies.leadTimeDays} days ahead.</li>
          <li><b>We feed your people.</b> We drop off and set up, or bring the grill and cook on-site.</li>
        </ol>
        <dl class="facts">
          <div><dt>Minimums</dt><dd>{money(policies.minimumDropoff)} pickup or drop-off. {money(policies.minimumOnsite)} for our grill on-site.</dd></div>
          <div><dt>Delivery</dt><dd>From ${policies.deliveryFrom}, setup included.</dd></div>
        </dl>
      </div>
      <figure class="photo">
        <Image src={grilling} alt="The Kreung LA team grilling skewers over open fire at an event" widths={[480, 800]} sizes="(min-width: 960px) 460px, 100vw" />
      </figure>
    </div>
  </section>

  <section class="sec sec--tight s-plum" aria-label="Clients and ratings">
    <div class="wrap"><ProofBar note /></div>
  </section>

  <section class="sec s-red" aria-labelledby="rev-h">
    <div class="wrap">
      <div class="head"><h2 id="rev-h">What clients say</h2></div>
      <Reviews keys={['repeatClient', 'rareBeauty', 'janeT']} />
      <p class="press-line">As seen in {press.map((p) => p.name).join(', ')}. <a href="/press">Read the press</a></p>
    </div>
  </section>

  <section class="sec s-mint">
    <div class="wrap">
      <Faq faqs={faqs} />
      <p class="more-faq"><a href="/faq">More questions</a> · <a href="/catering/pricing">Pricing</a> · <a href="/catering/menu">Menu</a></p>
    </div>
  </section>

  <CtaBand heading="Let's feed your people." text="See a price in a minute. We reply within 24 hours." href="/catering/corporate#estimate" label="Get a catering quote" />
</BaseLayout>
