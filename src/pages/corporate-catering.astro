---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Packages from '../components/Packages.astro';
import ProofBar from '../components/ProofBar.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import Estimator from '../components/Estimator.astro';
import CtaBand from '../components/CtaBand.astro';
import { policies, money, cateringMenu, press, clientNote, minimumsText } from '../data/business';
import office from '../assets/photos/event-office-lunch.jpg';
import skewers from '../assets/photos/food-skewers-tray.jpg';

const faqs = [
  { q: 'How much does corporate catering cost?', a: `Our packages are $20, $25 and $33 per person. Most office lunches pick the $25 Signature package with 2 proteins. Delivery starts at $${policies.deliveryFrom}, and sales tax applies.` },
  { q: 'What is the minimum order for office catering?', a: `The minimum is ${minimumsText}.` },
  { q: 'How far ahead do we need to book?', a: `Please book at least ${policies.leadTimeDays} days (2 weeks) ahead. ${policies.responseTime}` },
  { q: 'Do you deliver and set up?', a: `Yes. We deliver to ${policies.deliveryArea}. Delivery starts at $${policies.deliveryFrom} and includes setup.` },
  { q: 'Is there a production fee?', a: `Drop-off orders for ${policies.productionFeeDropoffThreshold}+ guests have a ${policies.productionFeeDropoffPct}% production fee. On-site cooking has a ${policies.productionFeeOnsitePct}% production fee, starting at $${policies.productionFeeOnsiteMin}. ${policies.productionFeeNote}` },
  { q: 'Can you handle vegan and allergy needs?', a: `Yes. Our tofu skewers are vegan. ${policies.allergyNote} Tell us about your team's needs when you ask for a quote.` },
  { q: 'How many people can you feed?', a: `We cater for ${policies.guestsLabel} guests, from small team lunches to company-wide events.` },
  { q: 'Can we add drinks?', a: `Yes. ${cateringMenu.drinks.join(', ').toLowerCase().replace(/^b/, 'B')} are available separately.` },
];

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Catering', path: '/catering' },
  { name: 'Corporate Catering', path: '/corporate-catering' },
];
---
<BaseLayout
  title="Corporate Catering in Los Angeles | Kreung LA"
  description="Cambodian BBQ catering for LA offices and teams. From $20 per person, 30 to 300+ guests, delivered and set up. See a price now, quote in 24 hours."
  path="/corporate-catering"
>
  <section class="sec s-yellow page-hero">
    <div class="wrap split split--wide">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1>Corporate Catering in Los Angeles: Cambodian BBQ for Your Team</h1>
        <p class="lede">Team lunches, all-hands, client days and office parties. We bring hot, fire-grilled food and set it up, so you can get back to work. Packages from $20 per person.</p>
        <div class="btn-row">
          <a class="btn" href="#estimate">Get your estimate</a>
          <a class="btn btn--o" href="/catering-menu">See the menu</a>
        </div>
      </div>
      <figure class="photo">
        <Image src={office} alt="Coworkers serving themselves from a Kreung LA catering spread at an office lunch" widths={[480, 800]} sizes="(min-width: 960px) 460px, 100vw" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="sec sec--tight s-plum" aria-label="Clients and ratings">
    <div class="wrap"><ProofBar note /></div>
  </section>

  <section class="sec s-cream" aria-labelledby="for-h">
    <div class="wrap split">
      <div>
        <h2 id="for-h">Made for busy teams</h2>
        <p class="lede">You need lunch that shows up on time, feeds everyone and gets people talking. That's us.</p>
        <ul class="check">
          <li>Office lunches and team meetings</li>
          <li>All-hands, offsites and client days</li>
          <li>Holiday parties and team celebrations</li>
          <li>Heritage month events and culture days</li>
          <li>Film, TV and studio crews (see <a href="/production-catering">production catering</a>)</li>
        </ul>
        <p>For many of your guests, it will be their first taste of Cambodian food. Bold, herby and smoky from the grill.</p>
      </div>
      <figure class="photo">
        <Image src={skewers} alt="A tray of Kreung LA beef skewers glazed and charred from the grill" widths={[480, 800]} sizes="(min-width: 960px) 460px, 100vw" />
      </figure>
    </div>
  </section>

  <section class="sec s-plum" aria-labelledby="pk-h">
    <div class="wrap">
      <div class="head">
        <h2 id="pk-h">Packages</h2>
        <p class="lede">Priced per person.</p>
      </div>
      <Packages />
      <p class="dl"><a href="/catering-pricing">How pricing works</a> · <a href="/catering-menu">Full catering menu</a></p>
    </div>
  </section>

  <section class="sec s-teal" aria-labelledby="how-h">
    <div class="wrap split">
      <div>
        <h2 id="how-h">How it works</h2>
        <ol class="howto">
          <li><b>Get your estimate below.</b> It takes about a minute.</li>
          <li><b>We send a real quote.</b> We reply within 24 hours, aiming for same day.</li>
          <li><b>Lock in your date.</b> Book at least {policies.leadTimeDays} days ahead.</li>
          <li><b>We deliver and set up.</b> Hot food, ready to serve.</li>
        </ol>
      </div>
      <dl class="facts facts--1">
        <div><dt>Minimums</dt><dd>{money(policies.minimumDropoff)} for weekday pickup and drop-off. {money(policies.minimumWeekend)} on weekends. {money(policies.minimumOnsite)} for our grill on-site.</dd></div>
        <div><dt>Delivery</dt><dd>{policies.deliveryArea.replace(/^m/, 'M')}, from ${policies.deliveryFrom}. Setup included.</dd></div>
        <div><dt>Production fee</dt><dd>{policies.productionFeeDropoffPct}% on drop-off orders for {policies.productionFeeDropoffThreshold}+ guests. {policies.productionFeeOnsitePct}% for on-site cooking, starting at ${policies.productionFeeOnsiteMin}. {policies.productionFeeNote}</dd></div>
        <div><dt>Guests</dt><dd>{policies.guestsLabel}.</dd></div>
      </dl>
    </div>
  </section>

  <section class="sec s-sky" aria-labelledby="menu-h">
    <div class="wrap">
      <div class="head">
        <h2 id="menu-h">What's on the menu</h2>
      </div>
      <div class="grid grid--3">
        <div class="card card--line">
          <h3>Proteins</h3>
          <ul>{cateringMenu.proteins.map((p) => <li>{p.name}{p.vegan && <strong> (vegan)</strong>}</li>)}</ul>
        </div>
        <div class="card card--line">
          <h3>Sides and rice</h3>
          <ul>{[...cateringMenu.sides, ...cateringMenu.rices, ...cateringMenu.sauces].map((s) => <li>{s.name}</li>)}</ul>
        </div>
        <div class="card card--line">
          <h3>Good to know</h3>
          <p>{policies.allergyNote}</p>
          <p>{cateringMenu.drinksNote} {cateringMenu.drinks.join(', ').toLowerCase().replace(/^b/, 'B')}.</p>
        </div>
      </div>
      <p class="more-faq"><a href="/catering-menu">See the full catering menu</a></p>
    </div>
  </section>

  <section class="sec s-red" aria-labelledby="rev-h">
    <div class="wrap">
      <div class="head">
        <h2 id="rev-h">Teams keep coming back</h2>
        <p class="lede">{clientNote}</p>
      </div>
      <div class="grid grid--2 rev2">
        <Reviews keys={['repeatClient', 'rareBeauty']} />
      </div>
      <p class="press-line">As seen in {press.map((p) => p.name).join(', ')}.</p>
    </div>
  </section>

  <Estimator defaultType="Corporate or office lunch" heading="Get your estimate" />

  <section class="sec s-mint">
    <div class="wrap">
      <Faq faqs={faqs} heading="Corporate catering questions" />
      <p class="more-faq"><a href="/faq">More questions</a> · <a href="/catering-pricing">Pricing</a> · <a href="/catering-menu">Menu</a> · <a href="/catering">All catering</a></p>
    </div>
  </section>

  <CtaBand heading="Lunch your team will talk about." text="See a price in a minute. We reply within 24 hours." href="#estimate" label="Get your estimate" />
</BaseLayout>

<style>
  .rev2 { display: block; }
  .rev2 :global(.reviews) { grid-template-columns: 1fr; }
  @media (min-width: 900px) { .rev2 :global(.reviews) { grid-template-columns: 1fr 1fr; } }
  .facts--1 { grid-template-columns: 1fr !important; }
</style>
