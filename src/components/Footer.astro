---
import { tone } from '../data/tones';
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-horizontal.png';
import { business, markets, links, khmer } from '../data/business';
const catering = [
  ['/catering', 'Plan an event'],
  ['/corporate-catering#estimate', 'Get an estimate'],
  ['/corporate-catering', 'Corporate catering'],
  ['/catering-pricing', 'Catering pricing'],
  ['/catering-menu', 'Catering menu'],
  ['/on-site-grill-catering', 'On-site grill'],
  ['/production-catering', 'Production & studio'],
  ['/office-lunch-club', 'Office Lunch Club'],
  ['/cambodian-catering-los-angeles', 'Cambodian catering'],
  ['/southeast-asian-catering', 'Southeast Asian catering'],
  ['/aapi-heritage-month-catering', 'AAPI Heritage Month'],
  ['/holiday-party-catering', 'Holiday parties'],
];
const eat = [
  ['/find-us', 'Weekly markets'],
  ['/rewards', 'Kreung Rewards'],
  ['/about', 'Our story'],
  ['/faq', 'FAQ'],
  ['/press', 'Press'],
];
const guides = [
  ['/guides/what-is-kreung', 'What is kreung?'],
  ['/guides/cambodian-vs-thai-food', 'Cambodian vs. Thai food'],
  ['/guides/office-lunch-ideas-los-angeles', 'Office lunch ideas in LA'],
  ['/guides/catering-cost-los-angeles', 'Catering cost in LA'],
];
---
<footer class="site-footer" {...tone('plum')}>
  <div class="wrap fgrid">
    <div class="fbrand">
      <Image src={logo} alt="Kreung LA" width={383} height={105} />
      <p class="ftag">{business.taglines.main}.<br />{business.taglines.mission}</p>
      <h2 class="fh">Contact</h2>
      <ul>
        <li><a href={`mailto:${business.email}`}>{business.email}</a></li>
        <li><a href={`sms:${business.phone.e164}`}>Text {business.phone.display}</a></li>
        <li><a href={links.instagram} rel="noopener">Instagram {business.instagram.handle}</a></li>
        <li><a href={links.yelp} rel="noopener">Yelp</a></li>
      </ul>
    </div>
    <div>
      <h2 class="fh">Weekly markets</h2>
      <ul class="fmk">
        {markets.map((m) => (<li><b>{m.day}, {m.hours}</b><br />{m.name}<br /><span class="dim">{m.address}</span></li>))}
      </ul>
    </div>
    <nav aria-label="Catering">
      <h2 class="fh">Catering</h2>
      <ul>{catering.map(([h, l]) => <li><a href={h}>{l}</a></li>)}</ul>
    </nav>
    <nav aria-label="Eat with us">
      <h2 class="fh">Eat with us</h2>
      <ul>{eat.map(([h, l]) => <li><a href={h}>{l}</a></li>)}</ul>
      <h2 class="fh fh--gap">Guides</h2>
      <ul>{guides.map(([h, l]) => <li><a href={h}>{l}</a></li>)}</ul>
    </nav>
    <div class="legal">
      <span>© {new Date().getFullYear()} {business.name} ({business.formerly}) · {business.city}, CA</span>
      <span class="mak">{business.taglines.footer} <span lang="km">{khmer.mak}</span></span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--plum); color: var(--cream); padding-block: 56px 32px; }
  .fgrid { display: grid; gap: 32px; }
  .fbrand img { width: 210px; height: auto; margin-bottom: 16px; }
  .ftag { font-stretch: 75%; font-weight: 850; text-transform: uppercase; font-size: 22px; line-height: 1.05; color: var(--yellow); }
  .fh { font: 600 15px/1.3 var(--f-text); text-transform: none; letter-spacing: 0; text-shadow: none; -webkit-text-stroke: 0; color: var(--cream); opacity: 0.75; margin: 0 0 10px; }
  .fh--gap { margin-top: 24px; }
  .site-footer ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .site-footer li { overflow-wrap: anywhere; }
  .site-footer a { text-decoration: none; }
  .site-footer a:hover { text-decoration: underline; color: var(--yellow); }
  .fmk li { line-height: 1.4; }
  .dim { opacity: 0.8; }
  .legal { grid-column: 1 / -1; border-top: 1px solid rgba(253, 242, 219, 0.4); padding-top: 18px; font-size: 14px; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .mak { font-weight: 800; color: var(--yellow); }
  @media (min-width: 700px) { .fgrid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1040px) { .fgrid { grid-template-columns: 1.3fr 1fr 1fr 1fr; } }
</style>
