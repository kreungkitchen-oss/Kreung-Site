---
/**
 * /catering — the main catering lead page.
 * Order (Sam, 2026-11-25): hero with price + minimum above the fold → client
 * logos → how it works (3 steps) → packages → menu highlights → testimonials →
 * case studies → press → FAQ → final CTA with the inquiry form (estimator).
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Packages from '../components/Packages.astro';
import ProofBar from '../components/ProofBar.astro';
import Reviews from '../components/Reviews.astro';
import CaseStudies from '../components/CaseStudies.astro';
import MenuHighlights from '../components/MenuHighlights.astro';
import PressGrid from '../components/PressGrid.astro';
import Placeholder from '../components/Placeholder.astro';
import Faq from '../components/Faq.astro';
import Estimator from '../components/Estimator.astro';
import { policies, money, cateringMenu, minimumsText } from '../data/business';
import { cities } from '../data/cities';
import { tone } from '../data/tones';
import spread from '../assets/photos/event-indoor-buffet.jpg';

const kinds = [
  { href: '/corporate-catering', title: 'Corporate catering', text: 'Team lunches, all-hands and office parties.' },
  { href: '/production-catering', title: 'Film & TV crews', text: 'Individually packed skewer meals, dropped off on set.' },
  { href: '/on-site-grill-catering', title: 'On-site grill', text: 'We bring the grill, generators and handwashing station.' },
  { href: '/office-lunch-club', title: 'Office Lunch Club', text: 'A standing Cambodian BBQ lunch for your team.' },
  { href: '/cambodian-catering-los-angeles', title: 'Cambodian catering', text: 'Real Khmer flavors for any party in LA.' },
  { href: '/southeast-asian-catering', title: 'Southeast Asian catering', text: 'Bright, herby food that is not the usual Thai tray.' },
  { href: '/aapi-heritage-month-catering', title: 'AAPI Heritage Month', text: 'A Cambodian American story your team can taste.' },
  { href: '/holiday-party-catering', title: 'Holiday parties', text: 'Year-end parties with smoke, fire and big flavor.' },
];

const drinks = cateringMenu.drinks.join(', ').toLowerCase();

const faqs = [
  { q: 'What is the minimum order?', a: `${minimumsText}.` },
  { q: 'How much does Cambodian catering cost per person?', a: `Most orders are ${policies.typicalRange} per person. Our premium spread, with all four meats including short rib and coconut lime leaf rice, is $${policies.premiumTop} per person. Delivery, sales tax and some production fees are extra. See our pricing page for a full example.` },
  { q: 'How far ahead do I need to book?', a: `Please book at least ${policies.leadTimeDays} days (2 weeks) ahead. We reply to every inquiry within 24 hours, usually the same day.` },
  { q: 'Where do you deliver, and what does it cost?', a: `We deliver to ${policies.deliveryArea}. Delivery starts at $${policies.deliveryFrom}, and we set up the food for you.` },
  { q: 'What is the production fee?', a: `It's a one-time charge: ${policies.productionFeeDropoffPct}% on drop-off orders for ${policies.productionFeeDropoffThreshold}+ guests, and ${policies.productionFeeOnsitePct}% for on-site cooking (starting at $${policies.productionFeeOnsiteMin}). It is not a gratuity. Sales tax still applies.` },
  { q: 'What do you need for on-site catering?', a: `Not much. Our on-site setup is self-sufficient. ${policies.onsiteSetup} Tell us about your venue when you send your inquiry.` },
  { q: 'Do you have vegan or allergy-friendly options?', a: `Yes. Our tofu skewers are vegan, and none of our food has dairy or peanuts. ${policies.allergyNote} Tell us about your guests' needs when you send your inquiry.` },
  { q: 'How do drinks work?', a: `Drinks are sold separately. You can add ${drinks} to any order.` },
  { q: 'How do I book?', a: `Pick a package, then send the inquiry form at the bottom of this page. It shows a ballpark price right away. We reply within 24 hours, usually the same day, with a real quote. You can also email or text us.` },
];

const crumbs = [{ name: 'Home', path: '/' }, { name: 'Catering', path: '/catering' }];
---
<BaseLayout
  title="Cambodian BBQ Catering for LA Teams | Kreung LA"
  description="Cambodian BBQ catering for LA teams. Most orders $20–25 per person, $500 weekday minimum, delivered and set up. Book 14 days ahead. Reply in 24 hours."
  path="/catering"
>
  <section class="sec page-hero cat-hero" {...tone('yellow')}>
    <div class="wrap split split--wide">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1>Cambodian BBQ catering for LA teams</h1>
        <p class="lede">Fire-grilled meats marinated in kreung, with rice, coconut corn and pickled veggies. Prices up front. A reply within 24 hours.</p>
        <ul class="price-strip" role="list">
          <li><b>{policies.typicalRange}</b><span>per person, most orders</span></li>
          <li><b>${policies.premiumTop}</b><span>per person, premium spread</span></li>
          <li><b>{money(policies.minimumDropoff)}</b><span>weekday drop-off minimum</span></li>
          <li><b>{money(policies.minimumOnsite)}</b><span>minimum on-site</span></li>
        </ul>
        <div class="btn-row">
          <a class="btn" href="#estimate">Get a quote in 24 hours</a>
          <a class="btn btn--o" href="#packages">See packages</a>
        </div>
      </div>
      <figure class="photo">
        <Image src={spread} alt="A Kreung LA catering buffet set up indoors with trays of grilled meats, rice and sides" widths={[480, 800]} sizes="(min-width: 960px) 460px, 100vw" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="sec sec--tight" {...tone('cream')} aria-label="Clients and ratings">
    <div class="wrap"><ProofBar heading="LA teams that eat with us" note /></div>
  </section>

  <section class="sec" {...tone('teal')} aria-labelledby="how-h">
    <div class="wrap">
      <div class="head">
        <h2 id="how-h">How it works</h2>
        <p class="lede">No consultation calls. No week-long back-and-forth. Three steps and you're booked.</p>
      </div>
      <ol class="steps3" role="list">
        <li><span class="n" aria-hidden="true">1</span><h3>Pick a package</h3><p>Prices are right on this page, per person. No guessing.</p></li>
        <li><span class="n" aria-hidden="true">2</span><h3>Send the inquiry</h3><p>One short form. We reply within 24 hours, usually the same day.</p></li>
        <li><span class="n" aria-hidden="true">3</span><h3>We deliver and set up</h3><p>Hot food, set up and ready. Book at least {policies.leadTimeDays} days ahead.</p></li>
      </ol>
    </div>
  </section>

  <section class="sec" id="packages" {...tone('plum')} aria-labelledby="pk-h">
    <div class="wrap">
      <div class="head">
        <h2 id="pk-h">Packages and per-person pricing</h2>
        <p class="lede">Most teams spend {policies.typicalRange} per person. Pick one, then send the inquiry for your exact price.</p>
      </div>
      <Packages />
      <p class="dl">Delivery covers {policies.deliveryArea}, from ${policies.deliveryFrom}, setup included. Drop-off orders for {policies.productionFeeDropoffThreshold}+ guests have a {policies.productionFeeDropoffPct}% production fee; on-site cooking has a {policies.productionFeeOnsitePct}% fee (from ${policies.productionFeeOnsiteMin}). {policies.productionFeeNote} <a href="/catering-pricing">How pricing works</a></p>
      <div class="btn-row"><a class="btn btn--y" href="#estimate">Price your event</a></div>
    </div>
  </section>

  <section class="sec" {...tone('cream')} aria-labelledby="menu-h">
    <div class="wrap">
      <div class="head">
        <h2 id="menu-h">What's on the menu</h2>
        <p class="lede">Every protein is grilled over fire. Drinks ({drinks}) are sold separately.</p>
      </div>
      <MenuHighlights />
      <p class="dl"><a href="/catering-menu">See the full catering menu</a></p>
    </div>
  </section>

  <section class="sec" {...tone('yellow')} aria-labelledby="rev-h">
    <div class="wrap">
      <div class="head"><h2 id="rev-h">What clients say</h2></div>
      <Reviews
        keys={['repeatClient', 'rareBeauty', 'janeT']}
        placeholders={['A corporate client quote (ideally Live Nation, SpaceX or Adobe), with name, title and company', 'A film or TV production quote (ideally Sony Pictures or DreamWorks)', 'An office-manager quote about the booking process or the 24-hour reply']}
      />
    </div>
  </section>

  <section class="sec" {...tone('orange')} aria-labelledby="cases-h">
    <div class="wrap">
      <div class="head"><h2 id="cases-h">Recent catering jobs</h2></div>
      <CaseStudies />
    </div>
  </section>

  <section class="sec" {...tone('cream')} aria-labelledby="press-h">
    <div class="wrap">
      <div class="head"><h2 id="press-h">In the press</h2></div>
      <PressGrid />
      <div class="grid grid--2">
        <Placeholder label="PRESS OUTLET NEEDED" detail="Eater LA: we have the name but no link yet. Send the article link." />
        <Placeholder label="PRESS OUTLET NEEDED" detail="Any other outlet: name, article title, link and logo file." />
      </div>
      <p class="press-line"><a href="/press">All press</a></p>
    </div>
  </section>

  <section class="sec" {...tone('teal')}>
    <div class="wrap">
      <Faq faqs={faqs} heading="Catering questions" />
      <p class="more-faq"><a href="/faq">More questions</a> · <a href="/catering-pricing">Pricing</a> · <a href="/catering-menu">Menu</a></p>
    </div>
  </section>

  <section class="sec" {...tone('cream')} aria-labelledby="near-h">
    <div class="wrap">
      <div class="head">
        <h2 id="near-h">Catering near you</h2>
        <p class="lede">We're based in Culver City and deliver to {policies.deliveryArea}.</p>
      </div>
      <ul class="near" role="list">
        {cities.map((c) => <li><a class="chip-link" href={`/catering/${c.slug}`}>{c.name} catering</a></li>)}
      </ul>
      <h2 class="h-sub" id="kinds-h">Catering by event</h2>
      <ul class="grid grid--4 doors" role="list" aria-labelledby="kinds-h">
        {kinds.map((k) => (
          <li><a class="card card--link" href={k.href}><h3>{k.title}</h3><p>{k.text}</p><span class="more" aria-hidden="true">Go →</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <Estimator defaultType="Corporate or office lunch" heading="Get your catering quote" />
</BaseLayout>

<style>
  .price-strip { list-style: none; padding: 0; margin: 20px 0 4px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  @media (min-width: 1100px) { .price-strip { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .price-strip li { background: var(--cream); border: 2.5px solid var(--plum); border-radius: 16px; padding: 10px 12px; display: grid; line-height: 1.15; }
  .price-strip b { font-size: clamp(22px, 3vw, 28px); font-weight: 900; font-stretch: 80%; }
  .price-strip span { font-size: 14px; font-weight: 600; }
  .cat-hero .lede { margin-bottom: 0; }
  /* Smaller H1 here so prices and the quote button sit above the fold on laptops. */
  .cat-hero h1 { font-size: clamp(40px, 5.2vw, 68px); }

  .steps3 { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  @media (min-width: 800px) { .steps3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .steps3 li { background: var(--cream); color: var(--plum); border: 2.5px solid var(--plum); box-shadow: 6px 6px 0 var(--plum); border-radius: var(--r-card); padding: 22px; }
  .steps3 .n { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--yellow); border: 2.5px solid var(--plum); font-weight: 900; font-size: 20px; margin-bottom: 10px; }
  .steps3 h3 { margin: 0 0 6px; font-size: 22px; color: var(--plum); -webkit-text-stroke: 0; text-shadow: none; }
  .steps3 p { margin: 0; }

  .near { list-style: none; padding: 0; margin: 0 0 36px; display: flex; flex-wrap: wrap; gap: 10px; }
  .chip-link { display: inline-block; padding: 10px 18px; border-radius: 999px; border: 2.5px solid var(--plum); background: var(--white); color: var(--plum); font-weight: 800; text-decoration: none; }
  .chip-link:hover { background: var(--yellow); }
  .h-sub { font-size: clamp(26px, 3.4vw, 36px); margin-bottom: 18px; }
  .grid.grid--2 :global(.ph-slot) { margin-top: 4px; }
</style>
