---
/**
 * Shared layout for /guides/* articles.
 * Top: breadcrumbs (Home > Guides > page), H1, lede, author box with
 * "Published" / "Last updated" dates (from the page's front matter), key takeaways.
 * Then: optional video, the article (slot), optional comparison tables,
 * FAQ (H2 + H3s), closing CTA, related pages and a sticky CTA.
 * JSON-LD: Article (here), BreadcrumbList (Breadcrumbs), FAQPage (Faq).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Faq from './Faq.astro';
import CtaBand from './CtaBand.astro';
import AuthorBox from './AuthorBox.astro';
import KeyTakeaways from './KeyTakeaways.astro';
import CompareTables from './CompareTables.astro';
import VideoSlot from './VideoSlot.astro';
import StickyCta from './StickyCta.astro';
import Related from './Related.astro';
import { article } from '../data/schema';
import { tone } from '../data/tones';

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  crumb: string;
  lede: string;
  datePublished: string;
  dateUpdated?: string;
  takeaways: string[];
  related: string[];
  faqs: { q: string; a: string }[];
  ctaHeading: string;
  ctaText: string;
  ctaHref?: string;
  ctaLabel?: string;
  compare?: ('packages' | 'service')[];
  video?: { youtubeId: string; title: string; caption?: string; captionsUrl?: string };
  noindex?: boolean;
}
const p = Astro.props;
const updated = p.dateUpdated ?? p.datePublished;
const ctaHref = p.ctaHref ?? '/catering/corporate#estimate';
const ctaLabel = p.ctaLabel ?? 'Get a catering quote';
const crumbs = [{ name: 'Home', path: '/' }, { name: 'Guides', path: '/guides' }, { name: p.crumb, path: p.path }];
---
<BaseLayout title={p.title} description={p.description} path={p.path} ogType="article" noindex={p.noindex}
  jsonLd={[article({ title: p.h1, description: p.description, path: p.path, datePublished: p.datePublished, dateModified: updated })]}>
  <section class="sec page-hero" {...tone('yellow')}>
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <p class="eyebrow">Guide</p>
      <h1>{p.h1}</h1>
      <p class="lede">{p.lede}</p>
      <AuthorBox published={p.datePublished} updated={updated} />
    </div>
  </section>

  <article class="sec" {...tone('cream')}>
    <div class="wrap">
      <KeyTakeaways items={p.takeaways} cta={{ label: ctaLabel, href: ctaHref }} />
      {p.video && <VideoSlot {...p.video} />}
      <div class="prose guide"><slot /></div>
      {p.compare && p.compare.length > 0 && <div class="guide-cmp"><CompareTables show={p.compare} /></div>}
    </div>
  </article>

  <section class="sec" {...tone('teal')}>
    <div class="wrap">
      <Faq faqs={p.faqs} />
      <p class="more-faq"><a href="/catering">Catering</a> · <a href="/catering/pricing">Catering prices</a> · <a href="/catering/menu">Catering menu</a></p>
    </div>
  </section>

  <CtaBand heading={p.ctaHeading} text={p.ctaText} href={ctaHref} label={ctaLabel} />
  <Related paths={p.related} />
  <StickyCta label={ctaLabel} href={ctaHref} />
</BaseLayout>
<style>
  .guide { font-size: 18px; }
  .guide :global(h2:first-child) { margin-top: 0; }
  .guide :global(.callout) { background: var(--white); border: 2.5px solid var(--plum); border-radius: 18px; padding: 18px 22px; box-shadow: 5px 5px 0 var(--plum); margin: 1.6em 0; }
  .guide :global(.callout p:last-child) { margin: 0; }
  .guide-cmp { margin-top: clamp(32px, 5vw, 56px); }
</style>
