---
/**
 * Optional YouTube video slot (Sam approved YouTube embeds, Nov 2026).
 * Renders nothing unless a page passes `youtubeId`. Click-to-play: a poster and
 * play button first; the youtube-nocookie iframe loads only after a click, with
 * captions turned on. Without JavaScript the button is a link to YouTube.
 * Pass `captionsUrl` (a transcript page or the video's captions) to link them.
 */
interface Props { youtubeId?: string; title?: string; caption?: string; captionsUrl?: string }
const { youtubeId, title = 'Video', caption, captionsUrl } = Astro.props;
const watch = youtubeId ? `https://www.youtube.com/watch?v=${youtubeId}` : '';
const embed = youtubeId ? `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&cc_load_policy=1&rel=0` : '';
---
{youtubeId && (
  <figure class="yt">
    <div class="yt__frame" data-yt={embed} data-title={title}>
      <img src={`https://i.ytimg.com/vi/${youtubeId}/hqdefault.jpg`} alt="" width="480" height="360" loading="lazy" />
      <a class="yt__play" href={watch} rel="noopener"><span class="visually-hidden">Play video: {title}</span><svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true"><path d="M66.5 7.7A8.5 8.5 0 0 0 60.5 1.7C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6c5.3 1.4 26.5 1.4 26.5 1.4s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3z" fill="#2b1b3f"/><path d="M45 24 27 14v20z" fill="#f7d63b"/></svg></a>
    </div>
    <figcaption>
      <b>{title}</b>{caption && <> {caption}</>}
      {captionsUrl && <> <a href={captionsUrl} rel="noopener">Read the captions</a></>}
    </figcaption>
  </figure>
)}
<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((box) => {
    box.querySelector('a')?.addEventListener('click', (e) => {
      e.preventDefault();
      const f = document.createElement('iframe');
      f.src = box.dataset.yt || '';
      f.title = box.dataset.title || 'Video';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      box.replaceChildren(f);
      f.focus();
    });
  });
</script>
<style>
  .yt { margin: 0 0 clamp(28px, 4vw, 44px); max-width: 860px; }
  .yt__frame { position: relative; aspect-ratio: 16 / 9; border: 3px solid var(--plum); border-radius: 18px; overflow: hidden; background: var(--plum); box-shadow: 6px 6px 0 var(--plum); }
  .yt__frame img, .yt__frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .yt__play { position: absolute; inset: 0; display: grid; place-items: center; }
  .yt__play:focus-visible { outline: 4px solid var(--yellow); outline-offset: -8px; }
  .yt figcaption { margin-top: 12px; font-size: 15px; }
</style>
