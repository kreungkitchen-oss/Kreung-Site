---
import BaseLayout from '../layouts/BaseLayout.astro';
import { khmer } from '../data/business';
import { tone } from '../data/tones';
---
<BaseLayout title="Page not found | Kreung LA" description="We couldn't find that page. Try catering, the menu or this week's markets." path="/404" noindex>
  <section class="sec page-hero nf" {...tone('yellow')}>
    <div class="wrap">
      <p class="kh big" lang="km" aria-hidden="true">{khmer.kreung}</p>
      <h1>This page went up in smoke.</h1>
      <p class="lede">We couldn't find what you were looking for. Here are some good places to start.</p>
      <div class="btn-row">
        <a class="btn" href="/catering">Catering</a>
        <a class="btn btn--o" href="/catering-menu">Catering menu</a>
        <a class="btn btn--o" href="/find-us">Find us this week</a>
        <a class="btn btn--o" href="/">Home</a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .nf .big { font-family: var(--f-khmer); font-size: clamp(80px, 16vw, 180px); line-height: 1.3; margin: 0; color: var(--pink); -webkit-text-stroke: 3px var(--plum); paint-order: stroke fill; text-shadow: 6px 6px 0 var(--teal); transform: rotate(-6deg); display: inline-block; }
</style>
