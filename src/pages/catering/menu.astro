---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Packages from '../../components/Packages.astro';
import Faq from '../../components/Faq.astro';
import CtaBand from '../../components/CtaBand.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import KeyTakeaways from '../../components/KeyTakeaways.astro';
import CompareTables from '../../components/CompareTables.astro';
import StickyCta from '../../components/StickyCta.astro';
import Related from '../../components/Related.astro';
import { cateringMenu, policies, khmer } from '../../data/business';
import { menuSchema, service } from '../../data/schema';
import plate from '../../assets/photos/plate-combo.jpg';
import chicken from '../../assets/photos/grill-chicken.jpg';
import spread from '../../assets/photos/food-catering-spread.jpg';
import LoopVideo from '../../components/LoopVideo.astro';

const meatNote = 'Fire-grilled and marinated in kreung.';
const sections = [
  { name: 'Proteins', items: cateringMenu.proteins.map((p) => ({ name: p.name, vegan: p.vegan, description: p.vegan ? 'Grilled tofu skewers. Vegan.' : meatNote })) },
  { name: 'Sides', items: cateringMenu.sides.map((s) => ({ name: s.name })) },
  { name: 'Rice', items: cateringMenu.rices.map((r) => ({ name: r.name })) },
  { name: 'Sauces', items: cateringMenu.sauces.map((s) => ({ name: s.name, description: 'Included with every package.' })) },
  { name: 'Drinks', items: cateringMenu.drinks.map((d) => ({ name: d, description: 'Available separately.' })) },
];

const published = '2026-11-24';
const updated = '2026-11-24';
const cta = 'Get a quote for this menu';
const ctaHref = '/catering/corporate#estimate';
const takeaways = [
  'Every meat is fire-grilled and marinated in kreung, our Cambodian herb paste.',
  'Pick 1 protein (Classic), 2 proteins (Signature) or all 4 meats (The Full Experience).',
  'Every package comes with rice, sides and house sauces.',
  'Our tofu skewers are vegan, and our food has no dairy or peanuts.',
  'Drinks are available separately.',
];

const faqs = [
  { q: 'Do you have vegan options?', a: 'Yes. Our tofu skewers are vegan. Our food also contains no dairy or peanuts.' },
  { q: 'Is your food dairy-free and peanut-free?', a: 'Yes. Our food contains no dairy or peanuts. Some dishes do contain fish sauce, oyster sauce, tamari and sesame oil.' },
  { q: 'What allergens are in your food?', a: policies.allergyNote },
  { q: 'What is kreung?', a: 'Kreung is the Cambodian herb paste of lemongrass, galangal, turmeric, makrut lime leaves, garlic and shallots. We marinate our meats in it before they hit the grill.' },
  { q: 'Which proteins come with each package?', a: 'Classic comes with 1 protein and Signature with 2. The Full Experience includes all 4 meats, including short rib, with coconut lime leaf rice.' },
];

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Catering', path: '/catering' },
  { name: 'Catering Menu', path: '/catering/menu' },
];
---
<BaseLayout
  title="Cambodian BBQ Catering Menu | Kreung LA"
  description="Our catering menu: lemongrass chicken, beef skewers, vegan tofu skewers, short rib, coconut corn, pickled veggies, rice and house sauces. No dairy or peanuts."
  path="/catering/menu"
  jsonLd={[menuSchema(sections, '/catering/menu'), service({ name: 'Cambodian BBQ catering menu', description: 'Catering menu: grilled lemongrass chicken, beef skewers, vegan tofu skewers, short rib, sides, rice and house sauces.', path: '/catering/menu' })]}
>
  <section class="sec s-yellow page-hero">
    <div class="wrap split split--wide">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1>Cambodian BBQ Catering Menu</h1>
        <p class="lede">Every meat is fire-grilled and marinated in kreung (<span lang="km">{khmer.kreung}</span>), our Cambodian herb paste. Pick your proteins, and we bring the rice, sides and house sauces.</p>
        <div class="btn-row">
          <a class="btn" href={ctaHref}>{cta}</a>
        </div>
        <AuthorBox published={published} updated={updated} />
      </div>
      <figure class="photo">
        <Image src={plate} alt="A Kreung LA plate with grilled meats, rice, coconut corn and pickled vegetables" widths={[480, 800]} sizes="(min-width: 960px) 460px, 100vw" loading="eager" />
      </figure>
    </div>
  </section>

  <section class="sec s-cream" aria-labelledby="menu-h">
    <div class="wrap">
      <KeyTakeaways items={takeaways} cta={{ label: cta, href: ctaHref }} />
      <h2 id="menu-h" class="visually-hidden">The menu</h2>
      <div class="menu-grid">
        <div class="card card--line menu-card big">
          <h3>Proteins</h3>
          <ul class="mlist">
            {cateringMenu.proteins.map((p) => (
              <li><b>{p.name}</b>{p.vegan ? <span class="vg">Vegan</span> : <span class="md">{meatNote}</span>}</li>
            ))}
          </ul>
          <p class="note">Classic: choose 1. Signature: choose 2. The Full Experience: all 4 meats.</p>
        </div>
        <div class="card card--line menu-card">
          <h3>Sides</h3>
          <ul class="mlist">{cateringMenu.sides.map((s) => <li><b>{s.name}</b></li>)}</ul>
        </div>
        <div class="card card--line menu-card">
          <h3>Rice</h3>
          <ul class="mlist">{cateringMenu.rices.map((r) => <li><b>{r.name}</b></li>)}</ul>
          <p class="note">Coconut lime leaf rice comes with The Full Experience.</p>
        </div>
        <div class="card card--line menu-card">
          <h3>Sauces</h3>
          <ul class="mlist">{cateringMenu.sauces.map((s) => <li><b>{s.name}</b><span class="md">Included with every package.</span></li>)}</ul>
        </div>
        <div class="card card--line menu-card">
          <h3>Drinks</h3>
          <ul class="mlist">{cateringMenu.drinks.map((d) => <li><b>{d}</b></li>)}</ul>
          <p class="note">{cateringMenu.drinksNote}</p>
        </div>
      </div>
      <div role="region" class="allergy" aria-labelledby="allergy-h">
        <h3 id="allergy-h">Allergy note</h3>
        <p>{policies.allergyNote} Tell us about any allergies when you ask for a quote.</p>
      </div>
    </div>
  </section>

  <section class="sec s-orange" aria-labelledby="photos-h">
    <div class="wrap">
      <h2 id="photos-h">Straight off the grill</h2>
      <div class="grid grid--2 pics">
        <figure class="photo"><Image src={chicken} alt="Kreung chicken thighs charring over the flames" widths={[480, 800]} sizes="(min-width: 960px) 560px, 100vw" /></figure>
        <figure class="photo"><Image src={spread} alt="A Kreung LA catering spread: skewers, grilled chicken, pickled vegetables, coconut corn, rice and house sauces" widths={[480, 800]} sizes="(min-width: 960px) 560px, 100vw" /></figure>
      </div>
      <div class="grid grid--2 loops">
        <LoopVideo src="/video/short-rib-tray.mp4" poster="/video/short-rib-tray.webp" width={432} height={768} caption="Short rib, off the grill and into the tray." />
        <LoopVideo src="/video/skewers-tray.mp4" poster="/video/skewers-tray.webp" width={432} height={768} caption="Skewers fresh off the grill." />
      </div>
    </div>
  </section>

  <section class="sec s-plum" aria-labelledby="pk-h">
    <div class="wrap">
      <div class="head">
        <h2 id="pk-h">Packages</h2>
        <p class="lede">Priced per person.</p>
      </div>
      <Packages />
      <p class="dl"><a href="/catering/pricing">How pricing works</a> · <a href="/catering">All catering options</a></p>
    </div>
  </section>

  <section class="sec s-cream" aria-label="Package comparison">
    <div class="wrap"><CompareTables show={['packages']} /></div>
  </section>

  <section class="sec s-mint">
    <div class="wrap">
      <Faq faqs={faqs} />
      <p class="more-faq"><a href="/faq">More questions</a> · <a href="/catering/pricing">Pricing</a> · <a href="/catering">All catering</a></p>
    </div>
  </section>

  <CtaBand heading="Hungry yet?" text="Tell us about your event. We reply within 24 hours." href={ctaHref} label={cta} />
  <Related paths={['/catering/pricing', '/guides/what-is-kreung', '/catering/cambodian', '/guides/how-much-food-for-50-people']} />
  <StickyCta label={cta} href={ctaHref} />
</BaseLayout>

<style>
  .menu-grid { display: grid; gap: 18px; }
  .menu-card h3 { margin-bottom: 14px; }
  .mlist { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
  .mlist li { display: grid; gap: 2px; font-size: 18px; }
  .mlist .md { color: var(--muted); font-size: 15px; }
  .vg { justify-self: start; background: var(--teal-d); color: #fff; border-radius: 999px; padding: 2px 10px; font-size: 13px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; }
  .note { margin: 16px 0 0; font-size: 15px; }
  .allergy { margin-top: 24px; background: var(--white); border: 2.5px dashed var(--plum); border-radius: 18px; padding: 18px 22px; }
  .allergy h3 { margin: 0 0 6px; font-size: 20px; }
  .allergy p { margin: 0; }
  .pics { margin-top: 28px; }
  .pics .photo { aspect-ratio: 4 / 3; }
  .loops { margin-top: 28px; }
  .loops :global(.loopv) { max-width: 360px; width: 100%; justify-self: center; }
  @media (min-width: 760px) { .menu-grid { grid-template-columns: repeat(2, 1fr); } .menu-grid .big { grid-row: span 2; } }
  @media (min-width: 1040px) { .menu-grid { grid-template-columns: repeat(3, 1fr); } }
</style>
