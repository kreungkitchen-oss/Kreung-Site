---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/dm-sans/index.css';
import '@fontsource/noto-sans-khmer/khmer-400.css';
import '@fontsource/noto-sans-khmer/khmer-700.css';
import '@fontsource/moul/khmer-400.css';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TextUs from '../components/TextUs.astro';
import Flood from '../components/Flood.astro';
import { businessEntity } from '../data/schema';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: object[];
  ogType?: string;
}
const { jsonLd = [], ...seo } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <SEO {...seo} jsonLd={[businessEntity(), ...jsonLd]} />
    <meta name="theme-color" content="#f7d63b" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Flood />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <TextUs />
  </body>
</html>
