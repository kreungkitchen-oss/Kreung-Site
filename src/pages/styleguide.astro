---
/* Temporary design-system page (noindex, left out of sitemap). Delete before launch. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Packages from '../components/Packages.astro';
import { edges, edgeMask } from '../data/edges';
import { tone, tones, type ToneName } from '../data/tones';
const colors = [
  ['--plum', '#2b1b3f'], ['--cream', '#fdf2db'], ['--yellow', '#f7d63b'], ['--orange', '#f4a100'], ['--pink', '#c75682'], ['--pink-d', '#9a3762'],
  ['--teal', '#2f95a1'], ['--teal-d', '#1f6f78'], ['--red', '#e8454f'], ['--red-d', '#b8283a'], ['--mint', '#bce6d1'], ['--sky', '#dffbff'], ['--muted', '#5b4d6b'],
];
const lum = (hex: string) => {
  const c = [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16) / 255).map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
  return 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
};
const ratio = (a: string, b: string) => { const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m); return (x + 0.05) / (y + 0.05); };
const pairs: [string, string, string, string][] = [
  ['Plum on cream', '#2b1b3f', '#fdf2db', 'body'], ['Plum on yellow', '#2b1b3f', '#f7d63b', 'body, buttons'], ['Plum on orange', '#2b1b3f', '#f4a100', 'body'],
  ['Muted on cream', '#5b4d6b', '#fdf2db', 'secondary text'], ['Muted on white', '#5b4d6b', '#ffffff', 'card text'], ['Cream on plum', '#fdf2db', '#2b1b3f', 'body'],
  ['Yellow on plum', '#f7d63b', '#2b1b3f', 'headings, buttons'], ['Cream on teal-d', '#fdf2db', '#1f6f78', 'markets section'], ['Cream on red-d', '#fdf2db', '#b8283a', 'reviews section'],
  ['Pink-d on cream', '#9a3762', '#fdf2db', 'small accents'], ['Plum on header red', '#2b1b3f', '#eb4872', 'header button'], ['Plum on mint', '#2b1b3f', '#bce6d1', 'body'],
  ['White on teal (brand)', '#ffffff', '#2f95a1', 'avoid for text'], ['White on pink (brand)', '#ffffff', '#c75682', 'large text only'], ['White on red (brand)', '#ffffff', '#e8454f', 'avoid for text'],
  ['Cream on orange', '#fdf2db', '#f4a100', 'outlined headings only'], ['White on yellow', '#ffffff', '#f7d63b', 'avoid']
];
---
<BaseLayout title="Style guide | Kreung LA" description="Kreung LA design system." noindex>
  <section class="sec s-yellow page-hero"><div class="wrap"><p class="eyebrow">Temporary page</p><h1>Design system</h1><p class="lede">Colors, type, buttons and cards for the Kreung LA site.</p></div></section>
  <section class="sec" {...tone('cream')} id="edges" aria-labelledby="edges-h">
    <div class="wrap">
      <h2 id="edges-h">Pick a flood edge</h2>
      <p class="lede">As you scroll, each section's color rises from the bottom of the screen. Which edge should it have? Tap one, then scroll down this page (or open the homepage) to see it move.</p>
      <div class="edge-opts">
        <figure class="edge-card">
          <div class="edge-demo" style="--c:#2B1B3F">
            <div class="em em-torn" aria-hidden="true"><i style={`--m:${edgeMask(edges.torn.rim)};background:#FDF2DB`}></i><i style={`--m:${edgeMask(edges.torn.front)}`}></i></div>
            <div class="edge-fill"></div>
          </div>
          <figcaption><b>Option A: Torn poster</b><span>Like a 1960s gig poster ripped off a wall, with the paper's cream core showing.</span></figcaption>
          <button class="btn btn--sm" type="button" data-pick-edge="torn">Use torn poster</button>
        </figure>
        <figure class="edge-card">
          <div class="edge-demo" style="--c:#2B1B3F">
            <div class="em em-flame" aria-hidden="true"><i style={`--m:${edgeMask(edges.flame.smoke)};opacity:.35`}></i><i style={`--m:${edgeMask(edges.flame.back)};opacity:.65`}></i><i style={`--m:${edgeMask(edges.flame.front)}`}></i></div>
            <div class="edge-fill"></div>
          </div>
          <figcaption><b>Option B: Flame and smoke</b><span>Licking flames with a soft smoke layer. The tongues shift sideways as you scroll.</span></figcaption>
          <button class="btn btn--sm" type="button" data-pick-edge="flame">Use flame and smoke</button>
        </figure>
      </div>
      <p class="picked" aria-live="polite" data-picked></p>
    </div>
  </section>
  {(['yellow', 'orange', 'plum', 'teal', 'pink', 'cream'] as ToneName[]).map((n) => (
    <section class="sec tone-demo" {...tone(n)}>
      <div class="wrap">
        <p class="eyebrow">Section tone: {n}</p>
        <h2>Scroll to see the flood</h2>
        <p class="lede">Background {tones[n].bg}, text {tones[n].fg}, heading {tones[n].hf}, shadow {tones[n].hs}.</p>
        <a class="btn" href="/corporate-catering#estimate">Sample button</a>
      </div>
    </section>
  ))}
  <section class="sec s-cream"><div class="wrap">
    <h2>Colors</h2>
    <div class="swatches">{colors.map(([n, h]) => <div class="swatch"><span style={`background:${h}`}></span><code>{n}</code><small>{h}</small></div>)}</div>
    <h2 style="margin-top:3rem">Contrast checks (WCAG AA)</h2>
    <table class="contrast"><thead><tr><th>Pair</th><th>Ratio</th><th>Result</th><th>Use</th></tr></thead><tbody>
      {pairs.map(([n, fg, bg, use]) => { const r = ratio(fg, bg); return <tr><td><span class="sample" style={`color:${fg};background:${bg}`}>Aa</span> {n}</td><td>{r.toFixed(2)}:1</td><td>{r >= 4.5 ? 'Pass (all text)' : r >= 3 ? 'Large text only' : 'Fail'}</td><td>{use}</td></tr>; })}
    </tbody></table>
  </div></section>
  <section class="sec s-sky"><div class="wrap">
    <h2>Type</h2>
    <p class="disp d-xl">Heading 1</p>
    <p class="disp d-l">Heading 2</p>
    <p class="disp d-m">Heading 3</p>
    <p class="lede">Lede paragraph. Plain, warm, confident. Short sentences.</p>
    <p>Body text in Archivo. Fire-grilled meats marinated in kreung. <a href="#">A link</a>. <span lang="km">ក្រឿង</span> <span class="kh" lang="km">ក្រឿង</span></p>
    <h2 style="margin-top:2rem">Buttons</h2>
    <div class="btn-row"><a class="btn" href="#">Primary</a><a class="btn btn--o" href="#">Outline</a><a class="btn btn--y" href="#">Yellow</a><a class="btn btn--sm" href="#">Small</a></div>
  </div></section>
  <section class="sec s-plum"><div class="wrap"><h2>Cards</h2><Packages /></div></section>
  <section class="sec s-teal"><div class="wrap"><h2>Teal section</h2><p>Cream text on deep teal.</p></div></section><section class="sec s-orange"><div class="wrap"><h2>Orange section</h2></div></section><section class="sec s-red"><div class="wrap"><h2>Red section</h2></div></section>
</BaseLayout>
<script>
  const picked = document.querySelector<HTMLElement>('[data-picked]');
  const show = () => { if (picked) picked.textContent = `Showing: ${document.documentElement.dataset.edge === 'flame' ? 'Option B, flame and smoke' : 'Option A, torn poster'}. Scroll down to see it.`; };
  document.querySelectorAll<HTMLButtonElement>('[data-pick-edge]').forEach((b) => b.addEventListener('click', () => {
    document.documentElement.dataset.edge = b.dataset.pickEdge;
    try { localStorage.setItem('kreung-edge', b.dataset.pickEdge || 'torn'); } catch {}
    show();
  }));
  show();
</script>
<style>
  .edge-opts { display: grid; gap: 22px; margin-top: 28px; }
  .edge-card { margin: 0; background: #fff; border: 2.5px solid var(--plum); border-radius: 22px; padding: 18px; box-shadow: 6px 6px 0 var(--plum); display: grid; gap: 14px; }
  .edge-demo { color: var(--c); background: var(--yellow); border-radius: 14px; overflow: hidden; padding-top: 50px; }
  .em { position: relative; height: 70px; margin-bottom: -1px; }
  .em-flame { height: 100px; }
  .em i { position: absolute; inset: 0; background: currentColor; -webkit-mask: var(--m) repeat-x 0 0 / auto 100%; mask: var(--m) repeat-x 0 0 / auto 100%; }
  .edge-fill { height: 70px; background: currentColor; }
  .edge-card figcaption { display: grid; gap: 4px; }
  .edge-card figcaption span { color: var(--muted); }
  .edge-card .btn { justify-self: start; }
  .picked { margin-top: 18px; font-weight: 800; }
  .tone-demo { min-height: 90vh; display: grid; align-items: center; }
  @media (min-width: 860px) { .edge-opts { grid-template-columns: 1fr 1fr; } }
</style>
<style>
  .swatches { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 12px; }
  .swatch { display: grid; gap: 4px; font-size: 0.85rem; }
  .swatch span { height: 64px; border: 2px solid var(--plum); border-radius: 10px; }
  .contrast { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .contrast th, .contrast td { padding: 8px; border-bottom: 1px solid var(--line); text-align: left; background: #fff; }
  .sample { display: inline-block; padding: 2px 8px; border-radius: 6px; font-weight: 700; border: 1px solid var(--line); }
</style>
