---
import BaseLayout from '../layouts/BaseLayout.astro';
import { links, business } from '../data/business';
---
<BaseLayout title="You're in! | Kreung LA" description="Thanks for joining Kreung Rewards." noindex>
  <section class="sec s-plum page-hero">
    <div class="wrap">
      <p class="eyebrow">Kreung Rewards</p>
      <h1>You're in!</h1>
      <p class="lede">Thanks for joining Kreung Rewards. You get $5 off when you join, and you earn a point every visit with a $15 minimum.</p>
      {/* TODO(Sam): explain how members redeem the $5 (e.g. Square loyalty by phone number?) */}
      <div class="btn-row"><a class="btn btn--y" href="/find-us">Find us this week</a><a class="btn btn--o" href={links.instagram} rel="noopener">Follow {business.instagram.handle}</a></div>
    </div>
  </section>
</BaseLayout>
